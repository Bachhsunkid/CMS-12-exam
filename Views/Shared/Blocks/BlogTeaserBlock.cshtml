@model BlogTeaserBlock
@inject IContentLoader ContentLoader
@inject IUrlResolver UrlResolver
@inject TrainingTest.Business.Authoring.IAuthorService AuthorService

@if (Model.Post is { } postReference
    && !ContentReference.IsNullOrEmpty(postReference)
    && ContentLoader.TryGet<BlogPostPage>(postReference, out var post))
{
    var authorUrl = AuthorService.GetUrl(post);
    var author = AuthorService.GetByReference(post.AuthorRef);
    <article class="teaser teaser--default">
        @if (!ContentReference.IsNullOrEmpty(post.HeroImage))
        {
            <img class="teaser__media" src="@UrlResolver.GetUrl(post.HeroImage)" alt="" />
        }
        else
        {
            <div class="teaser__media teaser__media--placeholder" aria-hidden="true">Hero image</div>
        }
        <div class="teaser__body">
            @if (!string.IsNullOrWhiteSpace(Model.Kicker))
            {
                <p class="teaser__kicker">@Model.Kicker</p>
            }
            <h3 class="teaser__title"><a href="@Url.ContentUrl(post.ContentLink)">@post.Title</a></h3>
            <p class="teaser__summary">@post.Summary</p>
            <p class="teaser__meta">
                @if (!string.IsNullOrWhiteSpace(authorUrl))
                {
                    <a class="teaser__author" href="@authorUrl">@author?.FullName</a>
                }
                else
                {
                    <span class="teaser__author">@author?.FullName</span>
                }
                <span class="teaser__date">@post.PublishDate?.ToString("MMM d, yyyy")</span>
                <span class="teaser__reading-time">@post.MainBody.EstimateReadingTime() min read</span>
            </p>
        </div>
    </article>
}
