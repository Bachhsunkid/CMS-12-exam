@model TrainingTest.Models.Blocks.FooterBlock

<footer class="site-footer">
    <div class="container site-footer__inner">
        <p>@Model.CopyrightText</p>
        @if (Model.NavigationLinks is not null)
        {
            <ul class="site-footer__links" role="list">
                @foreach (var item in Model.NavigationLinks.FilteredItems)
                {
                    <li>@Html.ContentLink(item.ContentLink)</li>
                }
            </ul>
        }
    </div>
</footer>
