@model TrainingTest.Models.Blocks.HeaderBlock

<header class="site-header">
    <div class="container site-header__inner">
        <a class="site-header__logo" href="@(Model.LogoLink?.ToString() ?? "/")">@Model.LogoText</a>
        <nav class="site-header__nav" aria-label="Primary">
            <ul role="list">
                @foreach (var link in Model.NavigationLinks ?? [])
                {
                    <li>@Html.ContentLink(link)</li>
                }
            </ul>
        </nav>
    </div>
</header>

