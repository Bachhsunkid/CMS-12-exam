@model BlogSearchViewModel
@inject UrlResolver UrlResolver
@using Microsoft.AspNetCore.WebUtilities

@{
    var blogListUrl = Url.ContentUrl(Model.Blog.ContentLink);

    string BuildSearchUrl(string? tag, int? periodDays, int page)
    {
        var query = new Dictionary<string, string?>();

        if (!string.IsNullOrWhiteSpace(Model.Request.Query)) query["q"] = Model.Request.Query;
        if (!string.IsNullOrWhiteSpace(tag)) query["tag"] = tag;
        if (periodDays.HasValue) query["period"] = periodDays.Value.ToString();
        if (Model.Request.QuickReadsOnly) query["quickreads"] = "1";
        if (Model.Request.Sort == BlogSearchSort.Newest) query["sort"] = "newest";
        if (page > 1) query["page"] = page.ToString();

        return QueryHelpers.AddQueryString(blogListUrl, query);
    }
}

<div class="container">
    <h1>@Model.Blog.Heading</h1>

    @if (Model.Blog.Intro is not null)
    {
        <div class="blog-intro">
            @Html.PropertyFor(model => model.Blog.Intro)
        </div>
    }

    @if (Model.Blog.MainContentArea is not null)
    {
        <div class="blog-list__main-content">
            @Html.PropertyFor(model => model.Blog.MainContentArea)
        </div>
    }

    <div class="blog-landing__layout">
        <aside class="blog-landing__facets" aria-label="Filter posts">
            <div id="facet-tag" data-component="facet-tag">
            <fieldset class="facet-group">
                <legend class="facet-group__title">Tag</legend>
                <ul class="facet-group__list" role="list">
                    @foreach (var facet in Model.TagFacets)
                    {
                            <li>
                                <a class="facet-option@(facet.IsSelected ? " is-selected" : string.Empty)"
                               href="@BuildSearchUrl(facet.IsSelected ? null : facet.Value, Model.Request.PeriodDays, 1)"
                               aria-current="@(facet.IsSelected ? "true" : null)">
                                <span class="facet-option__label">@facet.Label</span>
                                <span class="facet-option__count">@facet.Count</span>
                            </a>
                        </li>
                    }
                </ul>
            </fieldset>
            </div>

            <div id="facet-period" data-component="facet-period">
            <fieldset class="facet-group">
                <legend class="facet-group__title">Publish date</legend>
                <ul class="facet-group__list" role="list">
                    @foreach (var facet in Model.PeriodFacets)
                    {
                            <li>
                                <a class="facet-option@(facet.IsSelected ? " is-selected" : string.Empty)"
                               href="@BuildSearchUrl(Model.Request.Tag, facet.Value == "all" ? null : int.Parse(facet.Value), 1)"
                               aria-current="@(facet.IsSelected ? "true" : null)">
                                <span class="facet-option__label">@facet.Label</span>
                                <span class="facet-option__count">@facet.Count</span>
                            </a>
                        </li>
                    }
                </ul>
            </fieldset>
            </div>

            <label class="search-box__toggle">
                <input type="checkbox" id="quick-reads-toggle" name="quickreads" value="1"
                       form="blog-search-form" checked="@Model.Request.QuickReadsOnly" />
                Quick reads only (under 3 min)
            </label>
        </aside>

        <div class="blog-landing__results">
            <form class="search-box" id="blog-search-form" method="get">
                @if (Model.Request.Tag is not null)
                {
                    <input type="hidden" name="tag" value="@Model.Request.Tag" />
                }
                @if (Model.Request.PeriodDays.HasValue)
                {
                    <input type="hidden" name="period" value="@Model.Request.PeriodDays" />
                }
                <input type="search" class="search-box__input" id="search-input" name="q" value="@Model.Request.Query"
                       placeholder="Search posts by title, summary or body…" aria-label="Search blog posts" />
                <select class="search-box__sort" id="sort-select" name="sort" aria-label="Sort order">
                    <option value="relevance" selected="@(Model.Request.Sort == BlogSearchSort.Relevance)">Sort: relevance</option>
                    <option value="newest" selected="@(Model.Request.Sort == BlogSearchSort.Newest)">Sort: newest</option>
                </select>
                <button class="btn btn-primary" type="submit">Search</button>
            </form>

            <p class="blog-landing__count" id="results-count" aria-live="polite">
                @Model.TotalPosts post@(Model.TotalPosts == 1 ? string.Empty : "s") found
            </p>

            @if (Model.Posts.Count == 0)
            {
                <p class="blog-landing__empty">No posts match your filters.</p>
            }
            else
            {
                <ul class="content-area" id="post-list" data-component="teaser-list" role="list">
                    @foreach (var item in Model.Posts)
                    {
                        var post = item.Post;
                        <li class="content-item content-item--card">
                            <article class="teaser teaser--card">
                                @if (!ContentReference.IsNullOrEmpty(post.HeroImage))
                                {
                                    <img class="teaser__media" src="@UrlResolver.GetUrl(post.HeroImage)" alt="" />
                                }
                                else
                                {
                                    <div class="teaser__media teaser__media--placeholder" aria-hidden="true">Hero image</div>
                                }
                                <div class="teaser__card-body">
                                    @* @if (post.Tags?.FirstOrDefault() is { Length: > 0 } primaryTag) *@
                                    @* { *@
                                    @*     <span class="teaser__badge">@primaryTag</span> *@
                                    @* } *@
                                    @if (post.Tags?.Count > 0)
                                    {
                                        @foreach(var tag in post.Tags)
                                        {
                                            <span class="teaser__badge">@tag</span>
                                        }
                                    }
                                    <h3 class="teaser__title">
                                        <a href="@Url.ContentUrl(post.ContentLink)">@post.Title</a>
                                    </h3>
                                    <p class="teaser__meta">
                                        <span class="teaser__date">@post.PublishDate?.ToString("MMM d, yyyy")</span>
                                        <span class="teaser__reading-time">@post.MainBody.EstimateReadingTime() min</span>
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(item.AuthorUrl))
                                    {
                                        <a class="teaser__author" href="@item.AuthorUrl">@post.Author</a>
                                    }
                                    else
                                    {
                                        <span class="teaser__author">@post.Author</span>
                                    }
                                </div>
                            </article>
                        </li>
                    }
                </ul>
            }

            <div id="pagination-container">
                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination" aria-label="Pagination">
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            if (pageNumber == Model.CurrentPageNumber)
                            {
                                <span class="pagination__page is-current" aria-current="page">@pageNumber</span>
                            }
                            else
                            {
                                <a class="pagination__page" href="@BuildSearchUrl(Model.Request.Tag, Model.Request.PeriodDays, pageNumber)">@pageNumber</a>
                            }
                        }
                    </nav>
                }
            </div>
        </div>
    </div>
</div>
