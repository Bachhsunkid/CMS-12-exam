@model AuthorPageViewModel
@inject TrainingTest.Business.Authoring.IAuthorService AuthorService

<div class="container">
    <header class="author-profile__header">
        <div class="author-profile__avatar teaser__media--placeholder" aria-hidden="true">
            @GetInitials(Model.Author.FullName)
        </div>
        <div>
            <h1>@Model.Author.FullName</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Author.Bio))
            {
                <p class="author-profile__bio">@Model.Author.Bio</p>
            }
        </div>
    </header>

    <h2 class="author-profile__posts-heading">Posts by this author</h2>

    <ul class="content-area" role="list">
        @foreach (var post in Model.Posts)
        {
            <li class="content-item content-item--full">
                <article class="teaser teaser--default">
                    @if (!ContentReference.IsNullOrEmpty(post.HeroImage))
                    {
                        <img class="teaser__media" src="@Url.ContentUrl(post.HeroImage)" alt="" />
                    }
                    else
                    {
                        <div class="teaser__media teaser__media--placeholder" aria-hidden="true">Hero image</div>
                    }
                    <div class="teaser__body">
                        @if (post.Tags?.FirstOrDefault() is { Length: > 0 } primaryTag)
                        {
                            <p class="teaser__kicker">@primaryTag</p>
                        }
                        <h3 class="teaser__title"><a href="@Url.ContentUrl(post.ContentLink)">@post.Title</a></h3>
                        <p class="teaser__summary">@post.Summary</p>
                        <p class="teaser__meta">
                            <span class="teaser__date">@post.PublishDate?.ToString("MMM d, yyyy")</span>
                            <span class="teaser__reading-time">@post.MainBody.EstimateReadingTime() min read</span>
                        </p>
                    </div>
                </article>
            </li>
        }
    </ul>

    @if (Model.TotalPages > 1)
    {
        <nav class="pagination" aria-label="Pagination">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                if (pageNumber == Model.CurrentPageNumber)
                {
                    <span class="pagination__page is-current" aria-current="page">@pageNumber</span>
                }
                else
                {
                    <a class="pagination__page" href="@AuthorService.GetUrl(Model.Blog, Model.Author, pageNumber)">@pageNumber</a>
                }
            }
        </nav>
    }
</div>

@functions {
    private static string GetInitials(string? fullName)
    {
        return string.Concat((fullName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(name => name[0]))
            .ToUpperInvariant();
    }
}
