@inject ISearchUrlBuilder SearchUrlBuilder
@model SiteSearchViewModel

<main class="page-main">
    <div class="container">
        <h1>Search</h1>

        <form class="search-box" method="get" action="@Url.ContentUrl(Model.Page.ContentLink)">
            <input type="search" class="search-box__input" id="search-input" name="q" value="@Model.Request.Query" placeholder="Search the whole site…" aria-label="Search the whole site" />
            @if (Model.Request.Type != SiteSearchType.All)
            {
                <input type="hidden" name="type" value="@Model.Request.Type" />
            }
            <button class="btn btn-primary" type="submit">Search</button>
        </form>

        <nav class="site-search__type-filter" aria-label="Filter by content type">
            @foreach (var type in new[] { SiteSearchType.All, SiteSearchType.Page, SiteSearchType.BlogPost, SiteSearchType.Document })
            {
                <a class="type-filter__option@(Model.Request.Type == type ? " is-selected" : string.Empty)" href="@SearchUrlBuilder.GetSiteSearchUrl(Model, type)">@SearchUrlBuilder.GetSiteSearchTypeLabel(type)</a>
            }
        </nav>

        <p id="results-count" class="blog-landing__count" aria-live="polite">@Model.Paging.TotalItems result@(Model.Paging.TotalItems == 1 ? string.Empty : "s") found</p>

        <ul class="search-result-list" id="result-list" data-component="result-list" role="list">
            @if (Model.Results.Count == 0)
            {
                <li class="search-result">No results found.</li>
            }
            else
            {
                foreach (var result in Model.Results)
                {
                    <li class="search-result">
                        <span class="search-result__type">@SearchUrlBuilder.GetSiteSearchTypeLabel(result.Type)</span>
                        <h3 class="search-result__title"><a href="@result.Url">@result.Title</a></h3>
                        @if (!string.IsNullOrWhiteSpace(result.Excerpt))
                        {
                            <p class="search-result__excerpt">
                                @if (result.HasHighlightedExcerpt)
                                {
                                    @Html.Raw(result.Excerpt)
                                }
                                else
                                {
                                    @result.Excerpt
                                }
                            </p>
                        }
                    </li>
                }
            }
        </ul>

        @if (Model.Paging.TotalPages > 1)
        {
            <nav class="pagination" id="pagination-container" aria-label="Pagination">
                @for (var pageNumber = 1; pageNumber <= Model.Paging.TotalPages; pageNumber++)
                {
                    <a class="pagination__page@(pageNumber == Model.Paging.CurrentPage ? " is-current" : string.Empty)" href="@SearchUrlBuilder.GetSiteSearchUrl(Model, Model.Request.Type, pageNumber)" aria-current="@(pageNumber == Model.Paging.CurrentPage ? "page" : null)">@pageNumber</a>
                }
            </nav>
        }
    </div>
</main>
